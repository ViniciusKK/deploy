# Porta usada pelo servidor HTTP
PORT=4000

# Ambiente atual (development, production, test)
NODE_ENV=development

# Origens autorizadas a consumir a API (separe por vírgula)
CORS_ORIGINS=http://localhost:3000

# Limites básicos de rate limiting (janela em ms e número máximo de requisições)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Diretório onde o arquivo JSON com os dados será mantido
DB_DIR=server/data
DB_FILENAME=db.json

# URL base opcional para o frontend (ex.: https://api.suaaplicacao.com)
REACT_APP_API_BASE_URL=/api

# Provedor padrão para o tester (openai, claude, gemini)
LLM_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Clerk (autenticação) — https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=

# Stripe (assinaturas) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Opcional: assinatura do endpoint de webhook (stripe listen --forward-to localhost:3000/billing/webhook)
STRIPE_WEBHOOK_SECRET=
# Opcional: use um Price já criado no Stripe; se vazio, o preço R$15/mês é criado dinamicamente
STRIPE_PRICE_ID=

# URL do frontend para redirects do checkout
FRONTEND_URL=http://localhost:3001
